	game:GetService("RunService").Heartbeat:Connect(function()
		if Library.Flags["auto_armor"] then
			local character = game.Players.LocalPlayer.Character
			if character and character:FindFirstChild("BodyEffects") then
				local armor = character.BodyEffects:FindFirstChild("Armor")
				if armor and armor.Value < 100 then
					local shop = workspace:FindFirstChild("Ignored"):FindFirstChild("Shop")
					if shop then
						local armorShop = shop:FindFirstChild("[High-Medium Armor] - $2440")
						if armorShop then
							local savedPos = character.HumanoidRootPart.CFrame
							character.HumanoidRootPart.CFrame = armorShop.Head.CFrame
							fireclickdetector(armorShop.ClickDetector)
							wait(0.1)
							character.HumanoidRootPart.CFrame = savedPos
						end
					end
				end
			end
		end
	end)
	
	-- No Slow
	NoSlowToggle.Callback = function(state) end
	game:GetService("RunService").Heartbeat:Connect(function()
		if Library.Flags["no_slow"] then
			local character = game.Players.LocalPlayer.Character
			if character and character:FindFirstChild("BodyEffects") then
				local bodyEffects = character.BodyEffects
				if bodyEffects:FindFirstChild("Reload") then
					bodyEffects.Reload.Value = false
				end
				local movement = bodyEffects:FindFirstChild("Movement")
				if movement then
					for _, child in pairs(movement:GetChildren()) do
						if child.Name == "NoJumping" or child.Name == "NoWalkSpeed" or child.Name == "ReduceWalk" then
							child:Destroy()
						end
					end
				end
			end
		end
	end)
	
	-- Fly
	FlyToggle.Callback = function(state) end
	game:GetService("RunService").Heartbeat:Connect(function(delta)
		local flyEnabled = Library.Flags["fly"]
		local flyKeybindActive = Library.Flags["fly_bind_KEY STATE"] == "Always" or (Library.Flags["fly_bind_KEY STATE"] == "Hold" and Library.Flags["fly_bind_KEY"])
		if flyEnabled and flyKeybindActive then
			local character = game.Players.LocalPlayer.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
				local camera = workspace.CurrentCamera
				local uis = game:GetService("UserInputService")
				
				local x, y, z = 0, 0, 0
				if uis:IsKeyDown(Enum.KeyCode.W) then z = z - 1 end
				if uis:IsKeyDown(Enum.KeyCode.S) then z = z + 1 end
				if uis:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
				if uis:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
				if uis:IsKeyDown(Enum.KeyCode.Space) then y = y + 1 end
				if uis:IsKeyDown(Enum.KeyCode.LeftShift) then y = y - 1 end
				
				local direction = camera.CFrame:VectorToWorldSpace(Vector3.new(x, 0, z).Unit)
				local amount = Library.Flags["fly_increments"] or 20
				character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame + ((direction + Vector3.new(0, y, 0)) * (amount / 10) * (delta * 60))
			end
		end
	end)
	
	-- Auto Jump
	AutoJumpToggle.Callback = function(state) end
	game:GetService("RunService").Heartbeat:Connect(function()
		if Library.Flags["auto_jump"] then
			local character = game.Players.LocalPlayer.Character
			if character and character:FindFirstChild("Humanoid") then
				local humanoid = character.Humanoid
				if humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end)
	
	-- No Jump Cooldown
	NoJumpCooldownToggle.Callback = function(state)
		local character = game.Players.LocalPlayer.Character
		if character and character:FindFirstChild("Humanoid") then
			character.Humanoid.UseJumpPower = not state
		end
	end
	game.Players.LocalPlayer.CharacterAdded:Connect(function()
		if Library.Flags["no_jump_cooldown"] then
			game.Players.LocalPlayer.Character.Humanoid.UseJumpPower = false
		end
	end)
	
	-- Auto Reload
	AutoReloadToggle.Callback = function(state) end
	local function checkAutoReload()
		if Library.Flags["auto_reload"] then
			local character = game.Players.LocalPlayer.Character
			if character then
				local tool = character:FindFirstChildWhichIsA("Tool")
				if tool and tool:FindFirstChild("Ammo") and tool:FindFirstChild("GunScript") then
					if tool.Ammo.Value == 0 then
						tool:Activate()
					end
				end
			end
		end
	end
	game.Players.LocalPlayer.CharacterAdded:Connect(function(character)
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child:FindFirstChild("Ammo") then
				child.Ammo:GetPropertyChangedSignal("Value"):Connect(checkAutoReload)
			end
		end)
	end)
	
	-- Anti Void Kill
	AntiVoidKillToggle.Callback = function(state)
		workspace.FallenPartsDestroyHeight = state and -50000 or -500
	end
	
	-- Infinite Zoom
	InfiniteZoomToggle.Callback = function(state)
		game.Players.LocalPlayer.CameraMaxZoomDistance = state and 9e9 or 30
	end
	
	-- Show Chat
	ShowChatToggle.Callback = function(state)
		local chatGui = game.Players.LocalPlayer.PlayerGui:FindFirstChild("Chat")
		if chatGui and chatGui:FindFirstChild("Frame") then
			local chatChannel = chatGui.Frame:FindFirstChild("ChatChannelParentFrame")
			if chatChannel then
				chatChannel.Visible = state
			end
		end
	end
	
	-- Aspect Ratio
	AspectRatioToggle.Callback = function(state) end
	game:GetService("RunService").RenderStepped:Connect(function()
		if Library.Flags["aspect_ratio"] then
			local camera = workspace.CurrentCamera
			local horizontal = Library.Flags["horizontal_aspect_ratio"] or 1
			local vertical = Library.Flags["vertical_aspect_ratio"] or 1
			if vertical ~= 0 then
				camera:SetAttribute("AspectRatio", horizontal / vertical)
			end
		end
	end)
end
