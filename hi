	local function apply_trail(trailType)
		-- Clean up existing trail
		if current_trail then
			current_trail:Destroy()
			current_trail = nil
		end
		
		for _, attachment in pairs(trail_attachments) do
			if attachment then attachment:Destroy() end
		end
		trail_attachments = {}
		
		if trailType == "None" or not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then
			return
		end
		
		local hrp = lp.Character.HumanoidRootPart
		local AT1 = Instance.new("Attachment")
		AT1.Parent = hrp
		AT1.CFrame = CFrame.new(0, 0, 0.687942505)
		
		local AT2 = Instance.new("Attachment")
		AT2.Parent = hrp
		AT2.CFrame = CFrame.new(0, 0, -0.677116394)
		
		table.insert(trail_attachments, AT1)
		table.insert(trail_attachments, AT2)
		
		local trail = Instance.new("Trail")
		trail.Parent = hrp
		trail.FaceCamera = true
		trail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0)
		})
		trail.Attachment0 = AT1
		trail.Attachment1 = AT2
		
		if trailType == "Bright" then
			trail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			})
			trail.Lifetime = 1
			trail.Brightness = 20
			trail.Texture = "rbxassetid://9234319472"
		elseif trailType == "Dash" then
			trail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			})
			trail.Texture = "http://www.roblox.com/asset/?id=13703813488"
			trail.Lifetime = 0.25
			trail.LightEmission = 1
			trail.Brightness = 20
		elseif trailType == "Shadow" then
			trail.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			})
			trail.Lifetime = 1
			trail.Texture = "rbxassetid://9234319472"
		elseif trailType == "Basic" then
			trail.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 168, 28)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 168, 28))
			})
