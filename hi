								if Library.Flags["show_weapon"] then
									local tool = data.character:FindFirstChildWhichIsA("Tool")
									local weaponName = tool and tool.Name or "none"
									if type(weaponName) == "string" then
										data.weaponLabel.Text = weaponName
									else
										data.weaponLabel.Text = tostring(weaponName)
									end
									local weaponColor = Library.Flags["weapon_color"] or Color3.fromRGB(255, 255, 255)
									if type(weaponColor) == "table" and weaponColor.Color then
										weaponColor = weaponColor.Color
									end
									data.weaponLabel.TextColor3 = weaponColor
								end
							end
							
							-- Update distance
							if data.distanceLabel then
								local distance = math.floor((rootPosition - cameraPosition).Magnitude)
								data.distanceLabel.Text = distance .. " studs"
							end
							
							-- Update health
							if data.healthLabel and Library.Flags["healthbar"] then
								local health = math.floor(data.character.Humanoid.Health)
								local maxHealth = math.floor(data.character.Humanoid.MaxHealth)
								data.healthLabel.Text = health .. " / " .. maxHealth .. " HP"
								
								-- Health color based on percentage
								local healthPercent = health / maxHealth
