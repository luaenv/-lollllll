							local viewportSize = camera.ViewportSize
							local screenX = math.clamp(screen_position.X, 0, viewportSize.X)
							local screenY = math.clamp(screen_position.Y, 0, viewportSize.Y)
							magnitude = (vec2(screenX, screenY) - vec2(mouse.X, mouse.Y + gui_offset)).magnitude
							-- Add large penalty for off-screen players to prioritize on-screen ones
							magnitude = magnitude + 5000
						end
						
						-- Always find the closest player to mouse cursor
						if magnitude < closestDistance then
							closestDistance = magnitude
							closestPlayer = player
						end
					end
				end
