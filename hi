				thermal.TintColor = Color3.fromRGB(255, 50, 0)
				thermal.Contrast = thermalSensitivity / 5
				thermal.Brightness = thermalRange / 50
			else
				local thermal = lighting:FindFirstChild("ThermalVisionEffect")
				if thermal then
					thermal.Enabled = false
				end
			end
		end)
