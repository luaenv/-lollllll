				-- Update ESP info
				if data.frame and data.character:FindFirstChild("Humanoid") then
					local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
					if onScreen then
						data.frame.Visible = true
						data.frame.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 30)
						
						-- Update distance
						local distance = math.floor((rootPosition - cameraPosition).Magnitude)
						data.distanceLabel.Text = distance .. " studs"
						
						-- Update health
						local health = math.floor(data.character.Humanoid.Health)
						local maxHealth = math.floor(data.character.Humanoid.MaxHealth)
						data.healthLabel.Text = health .. " / " .. maxHealth .. " HP"
						
						-- Health color based on percentage
