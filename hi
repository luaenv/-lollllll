function YunDrawingApi:New3DLine()
    local _line = {
        Visible      = false;
        ZIndex       = 1;
        Transparency = 1;
        Color        = nColor(255, 255, 255);
        Thickness    = 1;
        From         = nVector3(0,0,0);
        To           = nVector3(0,0,0);
    };
