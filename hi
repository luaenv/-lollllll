				local rollSpeed = Library.Flags["roll_speed"] or 1
				local time = tick() * rollSpeed
				camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, math.rad(rollAmount * math.sin(time)))
			end
			
			-- Night Vision
