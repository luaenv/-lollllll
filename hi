	local function AutoBuy(itemName, isAmmo)
		local character = game.Players.LocalPlayer.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		local rootPart = character.HumanoidRootPart
		local rootPos = rootPart.CFrame
		local shop = workspace:FindFirstChild("Ignored")
		if not shop then return end
		shop = shop:FindFirstChild("Shop")
		if not shop then return end
		local obj = isAmmo and ItemTable.Ammo[itemName] or ItemTable.Guns[itemName]
		if not obj then return end
		local objectPath = shop:FindFirstChild(obj)
		if not objectPath then return end
		local clickDetector = objectPath:FindFirstChild("ClickDetector")
		if not clickDetector then return end
		local head = objectPath:FindFirstChild("Head")
		if head then
			rootPart.CFrame = head.CFrame
			task.wait(0.15)
		end
		safeFireClickDetector(clickDetector)
		task.wait(0.15)
		rootPart.CFrame = rootPos
	end
	
