	-- Callbacks for Desync are set in the Rage Features section above
	
	desync.calculate_position = function(origin, positionPreset, rotationPreset)
		local customXEnabled = Library.Flags["custom_x_enabled"]
		local customYEnabled = Library.Flags["custom_y_enabled"]
		local customZEnabled = Library.Flags["custom_z_enabled"]
		local x = customXEnabled and (Library.Flags["custom_x"] or 0) or 0
		local y = customYEnabled and (Library.Flags["custom_y"] or 0) or 0
		local z = customZEnabled and (Library.Flags["custom_z"] or 0) or 0
		
		local rotations = {
			["None"] = angle(0, 0, 0),
			["Back"] = angle(0, rad(180), 0),
			["Lay"] = angle(rad(90), 0, 0),
			["Shinji"] = angle(rad(180), rad(180), 0),
			["Jitter"] = angle(0, rad(math.random(30, 90)), 0),
			["Spin"] = angle(0, rad(desync.radians), 0),
			["Random"] = angle(rad(math.random(-180, 180)), rad(math.random(-180, 180)), rad(math.random(-180, 180)))
		}
		
		local positions = {
			["Target Strafe"] = origin * angle(0, rad(desync.radians), 0) * cfr(x, y, z),
			["None"] = origin * cfr(x, y, z)
		}
		
		local rotation = rotations[rotationPreset] or rotations["None"]
		local position = positions[positionPreset] or positions["None"]
		
		desync.final_position = position * rotation
	end
	
	desync.calculate_dc = function(origin)
		desync.frame_counter = desync.frame_counter + 1
		local dcType = Library.Flags["destroy_cheaters_type"] or "Randomize"
		local interval = Library.Flags["destroy_cheaters_interval"] or 0
		local minHealth = Library.Flags["destroy_cheaters_min_health"] or 0
		
		local destroy_cheaters = {
			["Nan"] = origin * cfr(0/0, 0/0, 1),
			["High Magnitude"] = origin * cfr(9e9, 9e9, 9e9),
			["Line Rendering Zone"] = origin * cfr(9e4, 9e4, 9e4),
			["Randomize"] = origin * cfr(math.random(1,2) == 2 and 9^math.random(4,9) or 1/0, -1000, 9^math.random(4,9))
		}
		
		if not desync.main_enabled then
			desync.final_position = origin
		end
		
		if interval > 0 and desync.frame_counter % interval == 0 then
			if lp.Character and lp.Character:FindFirstChild("Humanoid") and lp.Character.Humanoid.Health <= minHealth then
				desync.final_position = destroy_cheaters[dcType] or origin
			end
		end
	end
	
	desync.init = LPH_NO_VIRTUALIZE(function(position, visualize)
		if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
		
		desync.old_position = lp.Character.HumanoidRootPart.CFrame
		lp.Character.HumanoidRootPart.CFrame = position
		
		run.RenderStepped:Wait()
		
		if visualize and desync.clone then
			for _, part in pairs(lp.Character:GetChildren()) do
				if (part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("Part")) and part.Name ~= "HumanoidRootPart" then
					local cloned_part = desync.clone:FindFirstChild(part.Name)
					if cloned_part then
						cloned_part.CFrame = part.CFrame
					end
				end
			end
		end
		
		lp.Character.HumanoidRootPart.CFrame = desync.old_position
	end)
	
	desync.update_cham_properties = function()
		if not desync.cham or not desync.clone then return end
		local Highlight = desync.cham
		Highlight.Enabled = Library.Flags["desync_cham_highlight"] ~= false
		
		local material = Library.Flags["desync_cham_material"] or "ForceField"
		local texture = Library.Flags["desync_material_texture"] or "None"
		local reflectance = Library.Flags["desync_cham_reflectance"] or 0
		
		for _, part in pairs(desync.clone:GetChildren()) do
			if (part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("Part")) and part.Name ~= "HumanoidRootPart" then
				local chamColor = Library.Flags["desync_part_color"]
				part.Color = (type(chamColor) == "table" and chamColor.Color) or chamColor or Color3.fromRGB(255, 0, 0)
				part.Material = Enum.Material[material] or Enum.Material.ForceField
				
				if material == "ForceField" and texture ~= "None" then
					part.TextureID = utility.textures[texture] or ""
				elseif material == "Plastic" then
					part.Reflectance = reflectance
					part.TextureID = ""
				else
					part.TextureID = ""
				end
			end
		end
		
		if Highlight.Enabled then
			Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			local fillColor = Library.Flags["desync_visualizer_fill"]
			local outlineColor = Library.Flags["desync_visualizer_outline"]
			Highlight.FillColor = (type(fillColor) == "table" and fillColor.Color) or fillColor or Color3.fromRGB(0, 255, 255)
			Highlight.OutlineColor = (type(outlineColor) == "table" and outlineColor.Color) or outlineColor or Color3.fromRGB(0, 0, 0)
			local fillAlpha = (type(fillColor) == "table" and fillColor.Transparency) or 0.5
			local outlineAlpha = (type(outlineColor) == "table" and outlineColor.Transparency) or 0
			Highlight.OutlineTransparency = 1 - outlineAlpha
			Highlight.FillTransparency = 1 - fillAlpha
		end
	end
	
	desync.state = LPH_NO_VIRTUALIZE(function()
		if not lp.Character or not lp.Character:FindFirstChild("Humanoid") then return false end
		
		local magnitude = lp.Character.Humanoid.MoveDirection.magnitude
		local mode = Library.Flags["desync_mode"] or "Always"
		
		if mode == "Standing Only" then
			if magnitude > 0 then return false end
		elseif mode == "Moving Only" then
			if magnitude == 0 then return false end
		elseif mode == "Target Only" then
			if not (target and target.Character) then return false end
		end
		
		return true
	end)
	
	desync.think = LPH_NO_VIRTUALIZE(function()
		local spoofer = desync.main_enabled
		local is_destroying = desync.dc_enabled
		local active = spoofer or is_destroying
		
		if active then
			local state = desync.state()
			if not state then return end
			
			if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
			
			local hrp_cf = lp.Character.HumanoidRootPart.CFrame
			local attachToTarget = Library.Flags["attach_to_target"] and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
			local origin = attachToTarget and target.Character.HumanoidRootPart.CFrame or hrp_cf
			
			if spoofer then
				local positionPreset = Library.Flags["desync_position_preset"] or "None"
				local rotationPreset = Library.Flags["desync_rotation_preset"] or "None"
				desync.calculate_position(origin, positionPreset, rotationPreset)
				
				-- Apply custom rotation if enabled
				if Library.Flags["custom_rotation"] then
					local pitch = Library.Flags["pitch"] or 0
					local yaw = Library.Flags["yaw"] or 0
					local roll = Library.Flags["roll"] or 0
					desync.final_position = desync.final_position * angle(rad(pitch), rad(yaw), rad(roll))
				end
			end
			
			if is_destroying then
				desync.calculate_dc(origin)
			end
			
			desync.init(desync.final_position, Library.Flags["desync_visualize"])
			desync.update_cham_properties()
		end
	end)
	
