				elseif nvType == "White Phosphor" then
					nightVision.TintColor = Color3.fromRGB(200, 255, 200)
				elseif nvType == "Thermal" then
					nightVision.TintColor = Color3.fromRGB(255, 100, 0)
				else -- Infrared
					nightVision.TintColor = Color3.fromRGB(100, 0, 255)
				end
				
				nightVision.Brightness = nvIntensity
				nightVision.Saturation = 2
			else
				local nightVision = lighting:FindFirstChild("NightVisionEffect")
				if nightVision then
					nightVision.Enabled = false
				end
			end
			
			-- Thermal Vision
			if Library.Flags["thermal_vision"] then
				local thermalRange = Library.Flags["thermal_range"] or 50
				local thermalSensitivity = Library.Flags["thermal_sensitivity"] or 5
				
				-- Apply thermal color grading
