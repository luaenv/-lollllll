	local AimAssistAirPart = LegitSection:List({Name = "Air Part", Options = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "RightFoot", "LeftFoot"}, Default = "RightFoot"})
	local AimAssistPrediction = LegitSection:Slider({Name = "Prediction", Min = 0, Max = 1, Default = 0.1413, Decimals = 3})
	
	-- Silent Aim
	local SilentAimToggle = SilentAimSection:Toggle({Name = "Silent Aim"})
	local SilentAimHitPart = SilentAimSection:List({Name = "Hit Part", Options = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso"}, Default = "HumanoidRootPart"})
	local SilentAimAirPart = SilentAimSection:List({Name = "Air Part", Options = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "RightFoot", "LeftFoot"}, Default = "RightFoot"})
	local SilentAimPrediction = SilentAimSection:Slider({Name = "Prediction", Min = 0, Max = 1, Default = 0.1413, Decimals = 3})
	
	-- Aim Assist Implementation
	local target = nil
	local aimAssistActive = false
	
	AimAssistToggle.Callback = function(state)
		aimAssistActive = state
	end
	
	game:GetService("RunService").Heartbeat:Connect(function()
		if aimAssistActive and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			local closestPlayer = nil
			local closestDistance = math.huge
			local mouse = game.Players.LocalPlayer:GetMouse()
			
			for _, player in pairs(game.Players:GetPlayers()) do
				if player ~= game.Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local rootPart = player.Character.HumanoidRootPart
					local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(rootPart.Position)
					
					if onScreen then
						local distance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
						if distance < closestDistance then
							closestDistance = distance
							closestPlayer = player
						end
					end
				end
			end
			
			if closestPlayer and closestPlayer.Character then
				target = closestPlayer
				local hitPart = closestPlayer.Character:FindFirstChild(Library.Flags[AimAssistHitPart.Flag] or "HumanoidRootPart")
				if hitPart then
					local smoothing = Library.Flags[AimAssistSmoothing.Flag] / 100
					local prediction = Library.Flags[AimAssistPrediction.Flag] or 0.1413
					local velocity = hitPart.AssemblyLinearVelocity
					local targetPos = hitPart.Position + (velocity * prediction)
					
					local camera = workspace.CurrentCamera
					camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, targetPos), (100 - smoothing) / 100)
				end
			end
		end
	end)
	
	-- Silent Aim Hook (simplified - only if hookmetamethod exists)
	if hookmetamethod then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if SilentAimToggle.Toggled and self.Name == "MainEvent" then
				local args = {...}
				if getnamecallmethod() == "FireServer" and args[1] == "UpdateMousePosI2" and target and target.Character then
					local hitPart = target.Character:FindFirstChild(Library.Flags[SilentAimHitPart.Flag] or "HumanoidRootPart")
					if hitPart then
						local prediction = Library.Flags[SilentAimPrediction.Flag] or 0.1413
						local velocity = hitPart.AssemblyLinearVelocity
						args[2] = hitPart.Position + (velocity * prediction)
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	end
