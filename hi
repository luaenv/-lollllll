				local silentAimKeybindMode = Library.Flags["silent_aim_bind_KEY STATE"] or "Toggle"
				local silentAimActive = false
				
				if silentAimEnabled then
					if silentAimKeybindMode == "Always" then
						silentAimActive = true
					elseif silentAimKeybindMode == "Toggle" then
						silentAimActive = silentAimKeybind == true
					elseif silentAimKeybindMode == "Hold" then
						silentAimActive = silentAimKeybind == true
					else
						silentAimActive = silentAimKeybind == nil or silentAimKeybind == true
					end
				end
				
				-- Check for MainEvent in ReplicatedStorage
				-- Also check if it's a RemoteEvent with name "MainEvent"
				local isMainEvent = (self.Name == "MainEvent") or (self.ClassName == "RemoteEvent" and self.Name == "MainEvent")
				
				if isMainEvent and silentAimActive and method == "FireServer" then
					local args = {...}
					
					-- Check if this is the UpdateMousePosI2 call (first argument should be the string)
					if args[1] == "UpdateMousePosI2" and args[2] then
						-- Hit chance check
						local hitChance = Library.Flags["silent_aim_hit_chance"] or 100
						if math.random(1, 100) > hitChance then
							return oldRSNamecall(self, ...)
						end
						
						-- Get target for silent aim (use sticky aim if enabled)
						local stickySilentAim = Library.Flags["silent_aim_sticky_aim"]
						local silentTarget = stickySilentAim and silent_aim.locked_target or target_selection.player
						
						-- If no target or target is invalid, find a new one
						if not silentTarget or not silentTarget.Character or not silentTarget.Character:FindFirstChild("HumanoidRootPart") or not utility.validate_client(silentTarget) then
							local fov = Library.Flags["silent_aim_fov"] or 120
							local maxDistance = fov == 500 and math.huge or (fov * 10)
							target_selection.update_target(maxDistance)
							silentTarget = target_selection.player
							
							-- Lock target if sticky aim is enabled
							if stickySilentAim and silentTarget then
								silent_aim.locked_target = silentTarget
							end
						end
						
						-- Calculate predicted position if we have a valid target
						if silentTarget and silentTarget.Character and silentTarget.Character:FindFirstChild("HumanoidRootPart") and utility.validate_client(silentTarget) then
							-- Temporarily set target for calculations
							local oldTarget = target
							target = silentTarget
							
							silent_aim.calculate_part()
							silent_aim.calculate_prediction()
							-- Use a small delta time for velocity calculation (1/60 seconds)
							silent_aim.calculate_velocity(1/60)
							silent_aim.calculate_destination()
							
							-- Replace the vector argument with our predicted position
							if silent_aim.destination and silent_aim.velocity and silent_aim.prediction then
								local predictedPos = silent_aim.destination + (silent_aim.velocity * silent_aim.prediction)
								-- args[2] should be a Vector3 (game uses vector.create() but accepts Vector3)
								args[2] = predictedPos
								-- Restore original target before returning
								target = oldTarget
								return oldRSNamecall(self, table.unpack(args))
							end
							
							-- Restore original target
							target = oldTarget
						end
					end
					
					return oldRSNamecall(self, table.unpack(args))
				end
				
				return oldRSNamecall(self, ...)
			end)))
		end
	end
	
