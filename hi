	local desyncCham = nil
	
	DesyncToggle.Callback = function(state)
		desyncEnabled = state
		if state then
			local character = game.Players.LocalPlayer.Character
			if character then
				character.Archivable = true
				desyncClone = character:Clone()
				desyncClone.Parent = workspace
				desyncClone:FindFirstChild("HumanoidRootPart"):Destroy()
				
				for _, part in pairs(desyncClone:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.CanCollide = false
						part.Anchored = true
						part.Transparency = 0.5
						part.Material = Enum.Material[Library.Flags[DesyncChamMaterial.Flag] or "ForceField"]
						part.Color = Library.Flags[DesyncChamColor.Flag] or Color3.fromRGB(255, 0, 0)
					end
				end
				
				desyncCham = Instance.new("Highlight")
				desyncCham.Parent = desyncClone
				desyncCham.Enabled = DesyncVisualize.Toggled
			end
		else
			if desyncClone then
				desyncClone:Destroy()
				desyncClone = nil
			end
		end
	end
	
	DesyncVisualize.Callback = function(state)
		if desyncCham then
			desyncCham.Enabled = state
		end
	end
	
	-- Desync Hook (only create once)
	local desyncHook = nil
	if hookmetamethod then
		local oldIndex
		oldIndex = hookmetamethod(game, "__index", function(self, key)
			if not checkcaller() and key == "CFrame" and self == game.Players.LocalPlayer.Character and self:FindFirstChild("HumanoidRootPart") then
				local hrp = self.HumanoidRootPart
				local keybindActive = Library.Flags[DesyncKeybind.Flag .. "_KEY STATE"] == "Always" or (Library.Flags[DesyncKeybind.Flag .. "_KEY STATE"] == "Hold" and Library.Flags[DesyncKeybind.Flag .. "_KEY"])
				if desyncEnabled and keybindActive then
					local rotation = Library.Flags[DesyncRotation.Flag] or "None"
					local offset = Vector3.new(
						DesyncX.Toggled and Library.Flags[DesyncXAmount.Flag] or 0,
						DesyncY.Toggled and Library.Flags[DesyncYAmount.Flag] or 0,
						DesyncZ.Toggled and Library.Flags[DesyncZAmount.Flag] or 0
					)
					
					local rotations = {
						["None"] = CFrame.Angles(0, 0, 0),
						["Back"] = CFrame.Angles(0, math.rad(180), 0),
						["Lay"] = CFrame.Angles(math.rad(90), 0, 0),
						["Shinji"] = CFrame.Angles(math.rad(180), math.rad(180), 0),
						["Jitter"] = CFrame.Angles(0, math.rad(math.random(30, 90)), 0),
						["Spin"] = CFrame.Angles(0, tick() * 2, 0),
						["Random"] = CFrame.Angles(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
					}
					
					return hrp.CFrame * CFrame.new(offset) * (rotations[rotation] or rotations["None"])
				end
			end
			return oldIndex(self, key)
		end)
		desyncHook = oldIndex
	end
	
	game:GetService("RunService").Heartbeat:Connect(function()
		local keybindActive = Library.Flags[DesyncKeybind.Flag .. "_KEY STATE"] == "Always" or (Library.Flags[DesyncKeybind.Flag .. "_KEY STATE"] == "Hold" and Library.Flags[DesyncKeybind.Flag .. "_KEY"])
		if desyncEnabled and keybindActive and desyncClone then
			local character = game.Players.LocalPlayer.Character
			if character then
				-- Update clone
				for _, part in pairs(character:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						local clonePart = desyncClone:FindFirstChild(part.Name)
						if clonePart then
							clonePart.CFrame = part.CFrame
						end
					end
				end
			end
		end
	end)
