	run.Heartbeat:Connect(function(delta)
		if spinbot.enabled and Library.Flags["spinbot_bind"] == true then
			if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
				local rootPart = lp.Character.HumanoidRootPart
				local speed = Library.Flags["spinbot_speed"] or 50
				local jitter = Library.Flags["spinbot_jitter"] or false
				local jitterAmount = Library.Flags["spinbot_jitter_amount"] or 10
				local onlyInCombat = Library.Flags["spinbot_only_in_combat"] or false
				
				-- Check if should spin (only in combat condition)
				if onlyInCombat and not (target and target.Character and target.Character:FindFirstChild("Humanoid") and target.Character.Humanoid.Health > 0) then
					return
				end
				
				-- Update angle
				spinbot.current_angle = spinbot.current_angle + (speed * delta * 10)
				
				-- Apply jitter
				if jitter then
					spinbot.jitter_offset = math.random(-jitterAmount, jitterAmount) / 1000
				else
					spinbot.jitter_offset = 0
				end
				
				-- Animate spinning rings
				for i, ring in pairs(spinbot.rings) do
					if ring and ring.Parent then
						local ringSpeed = speed * 0.1 * (i % 2 == 0 and 1 or -1) -- Alternate rotation directions
						ring.CFrame = rootPart.CFrame * CFrame.Angles(0, spinbot.current_angle * ringSpeed, math.rad(90)) * CFrame.new(0, 0, 2 + i)
					end
				end
				
				-- Apply spin
				local currentCFrame = rootPart.CFrame
				local spinCFrame = CFrame.Angles(0, math.rad(spinbot.current_angle) + spinbot.jitter_offset, 0)
				rootPart.CFrame = currentCFrame * spinCFrame
				
				-- Update particle colors based on speed
				if spinbot.particles then
					local hue = (spinbot.current_angle % 360) / 360
					local color = Color3.fromHSV(hue, 1, 1)
					spinbot.particles.Color = ColorSequence.new(color)
					if spinbot.trail then
						spinbot.trail.Color = ColorSequence.new(color)
					end
					for _, ring in pairs(spinbot.rings) do
						if ring then ring.Color = color end
					end
				end
			end
		end
	end)
	
