						-- Get screen position (always calculate, even if off-screen)
						local screen_position, on_screen = utility.to_screen_point(rootpart.Position)
						
						-- Calculate distance to mouse cursor in screen space
						local magnitude
						if on_screen then
							-- Player is on screen, use direct screen space distance
							magnitude = (vec2(screen_position.X, screen_position.Y) - vec2(mouse.X, mouse.Y + gui_offset)).magnitude
						else
