			end
			local networkShouldSleep = false
			invisibleDesyncConnection = game:GetService("RunService").Heartbeat:Connect(function()
				if not Library.Flags["invisible_desync"] then return end
				local character = game.Players.LocalPlayer.Character
				if not character or not character:FindFirstChild("HumanoidRootPart") then return end
				networkShouldSleep = not networkShouldSleep
				safeSetFFlag("S2PhysicsSenderRate", tostring(2))
				safeSetFFlag("PhysicsSenderMaxBandwidthBps", tostring(math.pi/3))
				safeSetHiddenProperty(character.HumanoidRootPart, "NetworkIsSleeping", networkShouldSleep)
				local originalVelocity = character.HumanoidRootPart.Velocity
				local originalAssemblyVelocity = character.HumanoidRootPart.AssemblyLinearVelocity
				character.HumanoidRootPart.Velocity = originalVelocity + Vector3.new(math.random(-16000, 16000), math.random(-16000, 16000), math.random(-16000, 16000))
				character.HumanoidRootPart.AssemblyLinearVelocity = originalAssemblyVelocity + Vector3.new(math.random(-16000, 16000), math.random(-16000, 16000), math.random(-16000, 16000))
				game:GetService("RunService").RenderStepped:Wait()
				character.HumanoidRootPart.Velocity = originalVelocity
				character.HumanoidRootPart.AssemblyLinearVelocity = originalAssemblyVelocity
				safeSetFFlag("S2PhysicsSenderRate", tostring(1))
			end)
		else
			if invisibleDesyncConnection then
				invisibleDesyncConnection:Disconnect()
				invisibleDesyncConnection = nil
			end
			safeSetFFlag("S2PhysicsSenderRate", tostring(15))
			local character = game.Players.LocalPlayer.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				safeSetHiddenProperty(character.HumanoidRootPart, "NetworkIsSleeping", false)
			end
		end
