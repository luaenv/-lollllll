									indicator.Size = Vector3.new(0.1, 0.1, 0.1)
									indicator.Transparency = 1
									indicator.CFrame = CFrame.new(endPoint)
									indicator.Anchored = true
									indicator.CanCollide = false
									
									local billboard = Instance.new("BillboardGui", indicator)
									billboard.Size = UDim2.new(0, 100, 0, 50)
									billboard.AlwaysOnTop = true
									
									local text = Instance.new("TextLabel", billboard)
									text.Size = UDim2.new(1, 0, 1, 0)
									text.BackgroundTransparency = 1
									text.Text = "-" .. math.floor(health) .. ""
									text.TextColor3 = Library.Flags[HealthIndicatorColor.Flag] or Color3.fromRGB(255, 255, 255)
									text.TextSize = 20
									text.FontFace = Font.fromEnum(Enum.Font.Code)
									
									game:GetService("TweenService"):Create(text, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
									game:GetService("Debris"):AddItem(indicator, 2)
								end
								
								break
							end
						end
					end
				end
			end
		end)
	end
end
