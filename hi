		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		debris:AddItem(sound, 10)
	end)
	
	hit_detection.render_hit_cham = function()
		if not Library.Flags["hit_cham"] then return end
		if not hit_detection.current_player or not hit_detection.current_player.Character then return end
		
		local character = hit_detection.current_player.Character
		character.Archivable = true
		local model = character:Clone()
		model.Parent = ws
		model:FindFirstChild("HumanoidRootPart"):Destroy()
		
		for _, part in next, model:GetChildren() do
			if part.Name == "CUFF" or part.Name == "HumanoidRootPart" then
				part:Destroy()
			elseif (part:IsA("BasePart") or part:IsA("MeshPart") or part:IsA("Part")) and part.Name ~= "HumanoidRootPart" then
				part.Color = Library.Flags["hit_chams_color"] or Color3.fromRGB(255, 255, 255)
				part.Transparency = 1 - (Library.Flags["hit_chams_color"] and (type(Library.Flags["hit_chams_color"]) == "table" and Library.Flags["hit_chams_color"].Transparency or 0.5) or 0.5)
				part.CanCollide = false
				part.Anchored = true
				part.Material = Enum.Material[Library.Flags["hit_material"] or "ForceField"] or Enum.Material.ForceField
				part.Size = part.Size + Vector3.new(0.01, 0.01, 0.01)
			else
				part:Destroy()
			end
		end
		
		local lifetime = Library.Flags["on_hit_lifetime"] or 2
		debris:AddItem(model, lifetime)
	end
	
	hit_detection.render_3d_hit_marker = function()
		if not Library.Flags["3d_hit_marker"] then return end
		-- 3D hit marker would require game assets, placeholder for now
	end
	
	hit_detection.render_health_hit_marker = function()
		if not Library.Flags["health_indicator"] then return end
		-- Health indicator would require game assets, placeholder for now
	end
	
	hit_detection.init = function()
		hit_detection.render_hit_effect()
		hit_detection.render_3d_hit_marker()
		hit_detection.render_health_hit_marker()
		hit_detection.render_hit_cham()
		hit_detection.play_sound()
	end
	
	-- Complete Network Desync
	local networking = {
		last_slept = tick(),
		sleeping = false
	}
	
	networking.think = function()
		if Library.Flags["network_desync"] and Library.Flags["network_desync_bind"] == true then
			if table.find(Library.Flags["network_desync_type"] or {}, "physics sender rate") then
				safeSetFFlag("S2PhysicsSenderRate", tostring(Library.Flags["network_desync_fflag"] or 60))
			end
			
			if table.find(Library.Flags["network_desync_type"] or {}, "network sleeping") then
				if (tick() - networking.last_slept >= (Library.Flags["network_desync_interval"] or 100) / 1000) then
					networking.sleeping = not networking.sleeping
					safeSetHiddenProperty(lp.Character.HumanoidRootPart, "NetworkIsSleeping", networking.sleeping)
					networking.last_slept = tick()
				end
			end
		end
	end
	
	-- Complete Trails System
	local trails = {
		attachments = {},
		trail = nil
	}
	
	trails.refresh = LPH_NO_VIRTUALIZE(function()
		if trails.trail then
			trails.trail:Destroy()
			trails.trail = nil
		end
		
		for _, attachment in next, trails.attachments do
			attachment:Destroy()
		end
		
		trails.attachments = {}
	end)
	
	trails.apply_trail = function(trail)
		trails.refresh()
		
		if trail == "None" then return end
		if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
		
		local AT2 = Instance.new("Attachment")
		AT2.Parent = lp.Character.HumanoidRootPart
		AT2.CFrame = CFrame.new(0, 0, 0.687942505, 1, 0, 0, 0, 1, 0, 0, 0, 1)
		table.insert(trails.attachments, AT2)
		
		local AT1 = Instance.new("Attachment")
		AT1.Parent = lp.Character.HumanoidRootPart
		AT1.CFrame = CFrame.new(0, 0, -0.677116394, 1, 0, 0, 0, 1, 0, 0, 0, 1)
		table.insert(trails.attachments, AT1)
		
		if trail == "Bright" then
			trails.trail = Instance.new("Trail")
			trails.trail.Parent = lp.Character.HumanoidRootPart
			trails.trail.FaceCamera = true
			trails.trail.WidthScale = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Transparency = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Attachment0 = AT1
			trails.trail.Lifetime = 1
			trails.trail.Brightness = 20
			trails.trail.Texture = "rbxassetid://9234319472"
			trails.trail.Attachment1 = AT2
		elseif trail == "Dash" then
			trails.trail = Instance.new("Trail")
			trails.trail.Parent = lp.Character.HumanoidRootPart
			trails.trail.FaceCamera = true
			trails.trail.WidthScale = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Texture = "http://www.roblox.com/asset/?id=13703813488"
			trails.trail.Transparency = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Lifetime = 0.25
			trails.trail.LightEmission = 1
			trails.trail.Brightness = 20
			trails.trail.Attachment0 = AT1
			trails.trail.Attachment1 = AT2
		elseif trail == "Shadow" then
			trails.trail = Instance.new("Trail")
			trails.trail.Parent = lp.Character.HumanoidRootPart
			trails.trail.FaceCamera = true
			trails.trail.WidthScale = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Transparency = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0)
			}
			trails.trail.Attachment0 = AT1
			trails.trail.Lifetime = 1
			trails.trail.Texture = "rbxassetid://9234319472"
			trails.trail.Attachment1 = AT2
		elseif trail == "Basic" then
			trails.trail = Instance.new("Trail")
			trails.trail.Parent = lp.Character.HumanoidRootPart
			trails.trail.FaceCamera = true
			trails.trail.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 168, 28)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 168, 28))
			}
			trails.trail.WidthScale = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0.04),
				NumberSequenceKeypoint.new(1, 0.04)
			}
			trails.trail.MaxLength = 400
			trails.trail.Transparency = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.001, 0.50625),
				NumberSequenceKeypoint.new(1, 0.5125)
			}
			trails.trail.Attachment0 = AT1
			trails.trail.LightEmission = 1
			trails.trail.MinLength = 0
			trails.trail.TextureMode = Enum.TextureMode.Static
			trails.trail.Attachment1 = AT2
		end
	end
	
	-- Complete Desync Visualization Updates
	if desync and desync.update_cham_properties then
		-- This function is already defined in the desync section
		-- Just ensure it's called when needed
	end
	
	-- Connect Hit Detection to Gun Beams
	if ws:FindFirstChild("Ignored") and ws.Ignored:FindFirstChild("Siren") and ws.Ignored.Siren:FindFirstChild("Radius") then
		ws.Ignored.Siren.Radius.ChildAdded:Connect(function(instance)
			if instance.Name == "explosion" then return end
			
			local gun_beam = instance:WaitForChild("GunBeam", 5)
			if not gun_beam then return end
			
			local owner = instance:GetAttribute("OwnerCharacter")
			if owner == lp.Name then
				hit_detection.origin = gun_beam.Attachment0.WorldCFrame.p
				hit_detection.end_point = gun_beam.Attachment1.WorldCFrame.p
				
				if Library.Flags["bullet_tracers"] then
					gun_beam.Transparency = NumberSequence.new{
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(1, 1)
					}
					new_beam(hit_detection.origin, hit_detection.end_point)
				end
				
				if Library.Flags["hit_detection"] then
					local player = hit_detection.detect_closest_health_change(hit_detection.end_point, 20)
					if player then
						hit_detection.current_player = player
						hit_detection.init()
					end
				end
			end
		end)
	end
	
	-- Update Hit Detection Data Table
	run.RenderStepped:Connect(function()
		hit_detection.update_data_table()
	end)
	
	-- Run Network Desync Think Loop
	run.Heartbeat:Connect(function(delta)
		networking.think()
	end)
	
	-- Connect Trails to Character Added
	lp.CharacterAdded:Connect(function()
		if Library.Flags["local_trail"] and Library.Flags["local_trail"] ~= "None" then
			task.wait(1)
			trails.apply_trail(Library.Flags["local_trail"])
		end
	end)
	
	-- Note: Full ESP drawing system (names, boxes, health bars, etc.) would require Drawing API
	-- which is more complex. The Highlight-based ESP chams are implemented above.
	-- Full ESP drawing implementation can be added separately if needed.
	-- 
	-- Note: Misery Source Functions are defined outside this scope to prevent local register overflow
	-- They are accessible via genv.MiserySettings and genv.MiseryFunctions
end

