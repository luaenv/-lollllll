					local weld = Instance.new("WeldConstraint")
					weld.Part0 = part
					weld.Part1 = clone
					weld.Parent = part
					
					table.insert(characterCloneParts, {original = part, clone = clone, weld = weld})
				end
			end
		else
			for _, data in pairs(characterCloneParts) do
