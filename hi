	local function save_character()
		if not lp.Character then return end
		char_save = {}
		for _, v in next, lp.Character:GetChildren() do
			if v:IsA("BasePart") and v.Name ~= "Handle" and v.Name ~= "HumanoidRootPart" then
				-- TextureID is only valid for MeshPart
				local textureId = (v:IsA("MeshPart") and v.TextureID) or ""
				char_save[v.Name] = {v.Color, textureId}
			elseif v:IsA("Accessory") and v:FindFirstChild("Handle") then
				local handle = v.Handle
				local textureId = (handle:IsA("MeshPart") and handle.TextureID) or ""
				char_save[v.Name] = textureId
			end
		end
	end
	_G.save_character = save_character
	
	local function update_character_chams()
		if not lp.Character then return end
		
		if not Library.Flags["character_chams"] then
			for _, v in next, lp.Character:GetChildren() do
				if v:IsA("BasePart") and v.Name ~= "Handle" and v.Name ~= "HumanoidRootPart" then
					if char_save[v.Name] then
						v.Color = char_save[v.Name][1]
						v.Transparency = 0
						v.Material = Enum.Material.Plastic
						-- TextureID is only valid for MeshPart
						if v:IsA("MeshPart") then
							v.TextureID = char_save[v.Name][2]
						end
					end
				end
			end
			return
		end
		
		local chamsColor = Library.Flags["character_chams_color"] or Color3.fromRGB(255, 255, 255)
		local colorValue = (type(chamsColor) == "table" and chamsColor.Color) or chamsColor
		local alpha = (type(chamsColor) == "table" and chamsColor.Transparency) or 0
		
		for _, v in next, lp.Character:GetChildren() do
			if v:IsA("BasePart") and v.Name ~= "Handle" and v.Name ~= "HumanoidRootPart" then
				v.Color = colorValue
				v.Transparency = 1 - alpha
				v.Material = Enum.Material.ForceField
				-- TextureID is only valid for MeshPart
				if v:IsA("MeshPart") then
					local texture = Library.Flags["localplayer_texture"] or "None"
					local textures = {None = "", Web = "rbxassetid://0", Swirl = "rbxassetid://0", Checkers = "rbxassetid://0"}
					v.TextureID = textures[texture] or ""
				end
			end
		end
		
		if Library.Flags["character_highlight"] and not Library.Flags["gun_highlight"] then
			local_highlight.Enabled = true
			local_highlight.Adornee = lp.Character
			local fillColor = Library.Flags["character_fill"] or Color3.fromRGB(186, 171, 255)
			local fillValue = (type(fillColor) == "table" and fillColor.Color) or fillColor
			local fillAlpha = (type(fillColor) == "table" and fillColor.Transparency) or 0.5
			local outlineColor = Library.Flags["character_outline"] or Color3.fromRGB(0, 0, 0)
			local outlineValue = (type(outlineColor) == "table" and outlineColor.Color) or outlineColor
			local outlineAlpha = (type(outlineColor) == "table" and outlineColor.Transparency) or 1
			local_highlight.FillColor = fillValue
			local_highlight.OutlineColor = outlineValue
			local_highlight.OutlineTransparency = 1 - outlineAlpha
			local_highlight.FillTransparency = 1 - fillAlpha
		else
			local_highlight.Enabled = false
		end
	end
