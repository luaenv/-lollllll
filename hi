			--
			Teleport.MouseButton1Click:Connect(function()
				if Playerlist.CurrentPlayer ~= nil and Playerlist.CurrentPlayer ~= game.Players.LocalPlayer then
					local targetPlayer = Playerlist.CurrentPlayer
					if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
						local localPlayer = game.Players.LocalPlayer
						if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
							localPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
							Library:Notification("Teleported to " .. targetPlayer.Name, 3)
						end
					else
						Library:Notification("Target player has no character", 3)
					end
				end
			end)
			--
			Spectate.MouseButton1Click:Connect(function()
				if Playerlist.CurrentPlayer ~= nil and Playerlist.CurrentPlayer ~= game.Players.LocalPlayer then
					local targetPlayer = Playerlist.CurrentPlayer
					local localPlayer = game.Players.LocalPlayer
					
					if not spectating then
						-- Start spectating
						if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
							-- Store original character
							originalCharacter = localPlayer.Character
							
							-- Set camera to spectate target
							local camera = workspace.CurrentCamera
							if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
								camera.CameraSubject = targetPlayer.Character:FindFirstChild("Humanoid")
							end
							
							-- Create connection to handle target character changes
							spectateConnection = game:GetService("RunService").RenderStepped:Connect(function()
								if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
									camera.CameraSubject = targetPlayer.Character:FindFirstChild("Humanoid")
								else
									-- Target lost character, stop spectating
									if spectateConnection then
										spectateConnection:Disconnect()
										spectateConnection = nil
									end
									spectating = false
									SpectateLabel.Text = "Spectate"
									
									-- Restore camera to local player
									if originalCharacter and originalCharacter.Parent and originalCharacter:FindFirstChild("Humanoid") then
										camera.CameraSubject = originalCharacter:FindFirstChild("Humanoid")
										originalCharacter = nil
									elseif localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
										camera.CameraSubject = localPlayer.Character:FindFirstChild("Humanoid")
									end
								end
							end)
							
							spectating = true
							SpectateLabel.Text = "Stop Spectate"
							Library:Notification("Spectating " .. targetPlayer.Name, 3)
						else
							Library:Notification("Target player has no character", 3)
						end
					else
						-- Stop spectating
						if spectateConnection then
							spectateConnection:Disconnect()
							spectateConnection = nil
						end
						
						spectating = false
						SpectateLabel.Text = "Spectate"
						
						-- Restore camera to local player
						if originalCharacter and originalCharacter.Parent and originalCharacter:FindFirstChild("Humanoid") then
							workspace.CurrentCamera.CameraSubject = originalCharacter:FindFirstChild("Humanoid")
							originalCharacter = nil
						elseif localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
							workspace.CurrentCamera.CameraSubject = localPlayer.Character:FindFirstChild("Humanoid")
						end
						
						Library:Notification("Stopped spectating", 3)
					end
				end
			end)
			--
			task.spawn(function()
				task.wait(0.1)
				Playerlist:Refresh(game.Players:GetPlayers(), false)
			end)
			--
			game.Players.PlayerAdded:Connect(function()
				Playerlist:Refresh(game.Players:GetPlayers(), true)
