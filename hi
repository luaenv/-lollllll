		-- Convert distance to world distance (FOV * 10 = studs, or infinite if FOV is 100/500)
		local _distance = (distance == 100 or distance == 500) and math.huge or (distance * 10)
		local closestPlayer = nil
		local closestDistance = math.huge  -- Start with infinite distance to find closest
		
		for _, player in next, players:GetPlayers() do
			if player ~= lp then
				local object, humanoid, rootpart = utility.validate_client(player)
				
				if object and humanoid and rootpart then
					-- Check if player is within world distance limit (if distance is not infinite)
					if _distance ~= math.huge then
						local worldDistance = (rootpart.Position - camera.CFrame.Position).Magnitude
						if worldDistance > _distance then
							-- Skip this iteration
						else
							-- Get screen position (always calculate, even if off-screen)
							local screen_position, on_screen = utility.to_screen_point(rootpart.Position)
							
							-- Calculate distance to mouse cursor in screen space
