	aim_assist.calculate_prediction = function()
		local autoPred = Library.Flags["aim_assist_auto_prediction"]
		if autoPred then
			local pingvalue = stats.Network and stats.Network.ServerStatsItem and stats.Network.ServerStatsItem["Data Ping"]
			if pingvalue then
				local pingstr = pingvalue:GetValueString()
				local split = string.split(pingstr, "(")
				local ping = tonumber(split[1]) or 50
				local pingFactor = Library.Flags["aim_assist_ping_factor"] or 1500
				aim_assist.prediction = ping / pingFactor
			else
				aim_assist.prediction = 0.1413
			end
		else
			local manualPred = Library.Flags["aim_assist_prediction"] or "0.1413"
			aim_assist.prediction = tonumber(manualPred) or 0.1413
		end
	end
	
	aim_assist.calculate_velocity = LPH_NO_VIRTUALIZE(function(delta)
		if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end
		
		local velocityType = Library.Flags["aim_assist_velocity_type"] or "Velocity"
		if velocityType == "Velocity" then
			if aim_assist.hitpart then
				aim_assist.velocity = aim_assist.hitpart.AssemblyLinearVelocity
			elseif aim_assist.airpart then
				aim_assist.velocity = aim_assist.airpart.AssemblyLinearVelocity
			end
		else -- Recalculation
			local hrp = target.Character.HumanoidRootPart
			if aim_assist.previous_position == nil then
				aim_assist.previous_position = hrp.Position
			end
			
			if aim_assist.previous_position then
				aim_assist.velocity = utility.recalculate_velocity(aim_assist.previous_position, hrp.Position, delta)
				aim_assist.previous_position = hrp.Position
			end
		end
	end)
	
	aim_assist.calculate_destination = LPH_NO_VIRTUALIZE(function()
		if not target or not target.Character or not target.Character:FindFirstChild("Humanoid") then return end
		
		local humanoid = target.Character.Humanoid
		aim_assist.state = humanoid:GetState()
		
		if aim_assist.state == Enum.HumanoidStateType.Freefall then
			aim_assist.offset = Library.Flags["adjust_for_jumping"] and 1 or 0
			local airParts = Library.Flags["aim_assist_air_bone"] or {"RightFoot"}
			if type(airParts) ~= "table" then airParts = {airParts} end
			local selected_parts = utility.simplify_parts(airParts)
			aim_assist.airpart = utility.get_closest_part(target, selected_parts)
			
			if aim_assist.airpart then
				aim_assist.destination = aim_assist.airpart.Position + vec3(0, aim_assist.offset, 0)
			end
		else
			aim_assist.offset = 0
			local hitParts = Library.Flags["aim_assist_bone"] or {"Torso"}
			if type(hitParts) ~= "table" then hitParts = {hitParts} end
			local selected_parts = utility.simplify_parts(hitParts)
