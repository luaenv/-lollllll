	DesyncToggle.Callback = function(state)
		desyncEnabled = state
		if state then
			local character = game.Players.LocalPlayer.Character
			if character then
				character.Archivable = true
				desyncClone = character:Clone()
				desyncClone.Parent = workspace
				local hrp = desyncClone:FindFirstChild("HumanoidRootPart")
				if hrp then hrp:Destroy() end
				
				local material = Library.Flags["desync_cham_material"] or "ForceField"
				local chamColor = Library.Flags["desync_part_color"]
				local colorValue = (type(chamColor) == "table" and chamColor.Color) or chamColor or Color3.fromRGB(255, 0, 0)
				
				for _, part in pairs(desyncClone:GetChildren()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.CanCollide = false
						part.Anchored = true
						part.Transparency = 0.5
						part.Material = Enum.Material[material] or Enum.Material.ForceField
						part.Color = colorValue
					end
				end
				
				desyncCham = Instance.new("Highlight")
				desyncCham.Parent = desyncClone
				desyncCham.Enabled = Library.Flags["desync_visualize"] ~= false
			end
		else
			if desyncClone then
				desyncClone:Destroy()
				desyncClone = nil
			end
			if desyncCham then
				desyncCham:Destroy()
				desyncCham = nil
			end
		end
