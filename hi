	local function new_beam(origin, end_point)
		if not Library.Flags["bullet_tracers"] then return end
		
		local beam_part = Instance.new("Part")
		beam_part.Anchored = true
		beam_part.CanCollide = false
		beam_part.Transparency = 1
		beam_part.Size = Vector3.new(0.1, 0.1, 0.1)
		beam_part.CFrame = CFrame.new(origin)
		beam_part.Parent = ws
		
		local attachment0 = Instance.new("Attachment")
		attachment0.Parent = beam_part
		attachment0.Position = Vector3.new(0, 0, 0)
		
		local attachment1 = Instance.new("Attachment")
		attachment1.Parent = beam_part
		attachment1.Position = (end_point - origin)
		
		local beam = Instance.new("Beam")
		beam.Parent = beam_part
		beam.Attachment0 = attachment0
		beam.Attachment1 = attachment1
		beam.FaceCamera = Library.Flags[BeamFaceCamera.Flag] or true
		beam.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Library.Flags[BeamSettings0.Flag] or Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Library.Flags[BeamSettings1.Flag] or Color3.fromRGB(255, 255, 255))
		})
		
		local startAlpha = Library.Flags[BeamSettings0.Flag] and (type(Library.Flags[BeamSettings0.Flag]) == "table" and Library.Flags[BeamSettings0.Flag].Transparency or 0) or 0
		local endAlpha = Library.Flags[BeamSettings1.Flag] and (type(Library.Flags[BeamSettings1.Flag]) == "table" and Library.Flags[BeamSettings1.Flag].Transparency or 0) or 0
		
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1 - startAlpha),
			NumberSequenceKeypoint.new(1, 1 - endAlpha)
		})
		
		beam.LightEmission = Library.Flags["beam_emission"] or 1
		beam.Segments = (Library.Flags["beam_segments"] or 5) * 10
		beam.LightInfluence = Library.Flags["beam_influence"] or 1
		beam.Width0 = Library.Flags["beam_width"] or 1
		beam.Width1 = Library.Flags["beam_width"] or 1
		beam.TextureLength = Library.Flags["beam_texture_length"] or 2
		beam.TextureSpeed = Library.Flags["beam_texture_speed"] or 0.5
		local textureName = Library.Flags["beam_texture"] or "Double Helix"
		local tracers_ids = {} -- This should be defined elsewhere, but we'll handle it
		beam.Texture = tracers_ids[textureName] or ""
		beam.CurveSize0 = Library.Flags["beam_start_curve"] or 0.5
		beam.CurveSize1 = Library.Flags["beam_end_curve"] or 0.5
		
		local lifetime = Library.Flags["beam_lifetime"] or 5
		debris:AddItem(beam_part, lifetime)
	end
	
