	-- Desync Hook (only create once)
	local desyncHook = nil
	if hookmetamethod then
		local oldIndex
		oldIndex = hookmetamethod(game, "__index", function(self, key)
			if not checkcaller() and key == "CFrame" and self == game.Players.LocalPlayer.Character and self:FindFirstChild("HumanoidRootPart") then
				local hrp = self.HumanoidRootPart
				local keybindActive = Library.Flags["desync_keybind_KEY STATE"] == "Always" or (Library.Flags["desync_keybind_KEY STATE"] == "Hold" and Library.Flags["desync_keybind_KEY"])
				if desyncEnabled and keybindActive then
					local rotation = Library.Flags["desync_rotation_preset"] or "None"
					local xEnabled = Library.Flags["custom_x_enabled"]
					local yEnabled = Library.Flags["custom_y_enabled"]
					local zEnabled = Library.Flags["custom_z_enabled"]
					local offset = Vector3.new(
						xEnabled and (Library.Flags["custom_x"] or 0) or 0,
						yEnabled and (Library.Flags["custom_y"] or 0) or 0,
						zEnabled and (Library.Flags["custom_z"] or 0) or 0
					)
					
					local rotations = {
						["None"] = CFrame.Angles(0, 0, 0),
						["Back"] = CFrame.Angles(0, math.rad(180), 0),
						["Lay"] = CFrame.Angles(math.rad(90), 0, 0),
						["Shinji"] = CFrame.Angles(math.rad(180), math.rad(180), 0),
						["Jitter"] = CFrame.Angles(0, math.rad(math.random(30, 90)), 0),
						["Spin"] = CFrame.Angles(0, tick() * 2, 0),
						["Random"] = CFrame.Angles(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
					}
					
					return hrp.CFrame * CFrame.new(offset) * (rotations[rotation] or rotations["None"])
				end
			end
			return oldIndex(self, key)
		end)
		desyncHook = oldIndex
	end
	
