	local characterCloneParts = {}
	
	CharacterCloneEnable.Callback = function(state)
		local character = game.Players.LocalPlayer.Character
		if not character then return end
		
		if state then
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					local clone = part:Clone()
					clone.Name = "ChamPart"
					clone.Parent = character
					clone.Transparency = Library.Flags[CharacterCloneTransparency.Flag] / 100
					clone.Material = Enum.Material[Library.Flags[CharacterCloneMaterial.Flag]]
					clone.CanCollide = false
					clone.Anchored = true
					
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = part
					weld.Part1 = clone
					weld.Parent = part
					
					table.insert(characterCloneParts, {original = part, clone = clone, weld = weld})
				end
			end
		else
			for _, data in pairs(characterCloneParts) do
				if data.clone then data.clone:Destroy() end
				if data.weld then data.weld:Destroy() end
			end
			characterCloneParts = {}
		end
	end
	
	CharacterCloneTransparency.Callback = function(value)
		for _, data in pairs(characterCloneParts) do
			if data.clone then
				data.clone.Transparency = value / 100
			end
		end
	end
	
	CharacterCloneMaterial.Callback = function(value)
		for _, data in pairs(characterCloneParts) do
			if data.clone then
				data.clone.Material = Enum.Material[value]
			end
		end
	end
	
