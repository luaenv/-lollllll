		local checks = Library.Flags["target_selected_checks"] or {}
		if type(checks) ~= "table" then checks = {} end
		if #checks == 0 then
			target_selection.pass = true
		else
			local spawned_in = table.find(checks, "ForceField") and utility.is_godded(currentTarget) or false
			local knocked = table.find(checks, "Knocked") and utility.is_knocked(currentTarget) or false
			local friend_check = table.find(checks, "Friend") and lp:IsFriendsWith(currentTarget.UserId) or false
			local visible_check = table.find(checks, "Visible") and utility.is_visible(currentTarget.Character.HumanoidRootPart.Position) or true
			
